best_model = results_df.loc[
    results_df["Recall (Malignant)"].idxmax()
]

print("Model with highest malignant recall:", best_model["Model"])
print("Malignant recall:", round(best_model["Recall (Malignant)"], 4))

CELL 11

tree_counts = [10, 50, 100, 200]
tree_results = []

for n in tree_counts:
    model = RandomForestClassifier(
        n_estimators=n,
        random_state=42
    )

    start_time = time.time()
    model.fit(X_train, y_train)
    training_time = time.time() - start_time

    y_pred = model.predict(X_test)

    tree_results.append({
        "Number of Trees": n,
        "Accuracy": accuracy_score(y_test, y_pred),
        "Malignant Recall": recall_score(
            y_test, y_pred, pos_label=0, zero_division=0
        ),
        "Training Time (s)": training_time
    })

tree_df = pd.DataFrame(tree_results)
tree_df.round(4)

CELL 12

plt.plot(
    tree_df["Number of Trees"],
    tree_df["Accuracy"],
    marker="o"
)

plt.title("Number of Trees vs Accuracy")
plt.xlabel("Number of Trees")
plt.ylabel("Accuracy")
plt.grid(True)
plt.show()

